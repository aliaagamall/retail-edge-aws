      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="140149602076192" parent="1" style="whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=23;fontColor=#16191F;fontFamily=Helvetica;fontStyle=1;" value="RetailEdge Inc. — Credential Management" vertex="1">
          <mxGeometry height="32" width="900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="140149602076384" parent="1" style="whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#6B6B6B;fontFamily=Helvetica;fontStyle=2;" value="Database credentials are never stored in application code, Docker images, AMIs, or User Data" vertex="1">
          <mxGeometry height="20" width="900" x="40" y="54" as="geometry" />
        </mxCell>
        <mxCell id="140149602076528" parent="1" style="whiteSpace=wrap;rounded=0;fillColor=#ED7100;strokeColor=none;sketch=0;dashed=0;outlineConnect=0;fontColor=#16191F;gradientColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12.5;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fontFamily=Helvetica;" value="EC2&#xa;Application Container" vertex="1">
