          <mxGeometry height="46" width="470" x="260" y="475" as="geometry" />
        </mxCell>
        <mxCell id="300149602080430" parent="1" style="whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D5DBE1;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#16191F;fontFamily=Helvetica;arcSize=6;spacing=8;" value="2. CodeDeploy agent on each EC2 instance pulls the target Docker image from ECR" vertex="1">
          <mxGeometry height="46" width="470" x="260" y="530" as="geometry" />
        </mxCell>
        <mxCell id="300149602080440" parent="1" style="whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D5DBE1;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#16191F;fontFamily=Helvetica;arcSize=6;spacing=8;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="3. New (Green) environment provisioned alongside current (Blue) production; new container started on Green" vertex="1">
          <mxGeometry height="46" width="470" x="260" y="585" as="geometry" />
        </mxCell>
        <mxCell id="300149602080450" parent="1" style="whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D5DBE1;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#16191F;fontFamily=Helvetica;arcSize=6;spacing=8;" value="4. Health validation against Green via the /health endpoint (same endpoint used by the ALB Target Group)" vertex="1">
