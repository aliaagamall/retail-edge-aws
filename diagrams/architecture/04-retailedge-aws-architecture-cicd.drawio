        </mxCell>
        <mxCell id="140149602076960" parent="1" style="whiteSpace=wrap;rounded=0;fillColor=#3B48CC;strokeColor=none;sketch=0;dashed=0;outlineConnect=0;fontColor=#16191F;gradientColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12.5;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds_mysql_instance;fontFamily=Helvetica;" value="RDS MySQL" vertex="1">
          <mxGeometry height="72" width="72" x="140" y="750" as="geometry" />
        </mxCell>
        <mxCell id="140149602077104" edge="1" parent="1" source="140149602076528" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;entryX=0.5;entryY=0;exitX=0.5;exitY=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;fontSize=11.5;fontColor=#16191F;" target="140149602076672" value="assumes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="140149602077200" edge="1" parent="1" source="140149602076672" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;entryX=0.5;entryY=0;exitX=0.5;exitY=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;fontSize=11.5;fontColor=#16191F;" target="140149602076816" value="AWS SDK: GetSecretValue&#xa;(least-privilege policy)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="140149602077344" edge="1" parent="1" source="140149602076816" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;entryX=0.5;entryY=0;exitX=0.5;exitY=1;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;fontSize=11.5;fontColor=#16191F;" target="140149602076960" value="returns DB credentials&#xa;(used at runtime by app)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="140149602077488" parent="1" style="whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#16191F;fontFamily=Helvetica;fontStyle=1;" value="Credential retrieval flow" vertex="1">
          <mxGeometry height="26" width="500" x="440" y="130" as="geometry" />
        </mxCell>
        <mxCell id="140149602077728" parent="1" style="whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D5DBE1;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#16191F;fontFamily=Helvetica;arcSize=4;spacing=8;" value="1.  EC2 instance launches with an attached IAM Role (least-privilege policy) — no AWS access keys stored on the instance, image, or container." vertex="1">
          <mxGeometry height="60" width="620" x="440" y="175" as="geometry" />
        </mxCell>
        <mxCell id="140149602077920" parent="1" style="whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D5DBE1;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#16191F;fontFamily=Helvetica;arcSize=4;spacing=8;" value="2.  At runtime, the application inside the Docker container uses the instance&#39;s IAM Role credentials (via the metadata service) to call Secrets Manager." vertex="1">
          <mxGeometry height="60" width="620" x="440" y="250" as="geometry" />
        </mxCell>
        <mxCell id="140149602078064" parent="1" style="whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D5DBE1;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#16191F;fontFamily=Helvetica;arcSize=4;spacing=8;" value="3.  Secrets Manager authorizes the GetSecretValue call based on the IAM Role&#39;s policy and returns the current DB credentials." vertex="1">
          <mxGeometry height="60" width="620" x="440" y="325" as="geometry" />
        </mxCell>
        <mxCell id="140149602078208" parent="1" style="whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D5DBE1;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#16191F;fontFamily=Helvetica;arcSize=4;spacing=8;" value="4.  The application uses the retrieved credentials to open its connection to RDS MySQL over the App-SG → RDS-SG path (port 3306)." vertex="1">
          <mxGeometry height="60" width="620" x="440" y="400" as="geometry" />
        </mxCell>
        <mxCell id="140149602078352" parent="1" style="whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D5DBE1;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#16191F;fontFamily=Helvetica;arcSize=4;spacing=8;" value="5.  Credential rotation in Secrets Manager requires no code, container image, AMI, or User Data changes on the EC2 fleet." vertex="1">
          <mxGeometry height="60" width="620" x="440" y="475" as="geometry" />
        </mxCell>
        <mxCell id="140149602077632" parent="1" style="whiteSpace=wrap;rounded=1;fillColor=#FFF9E6;strokeColor=#D9A400;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#16191F;fontFamily=Helvetica;arcSize=4;spacing=8;" value="IAM roles and Secrets Manager policies follow least privilege: EC2 instances are granted only the specific GetSecretValue permission on the RetailEdge database secret — not broad Secrets Manager or IAM access. Full IAM policy JSON and secret rotation configuration will be defined during the detailed design phase." vertex="1">
          <mxGeometry height="70" width="620" x="440" y="565" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
