        <mxCell id="P3REDISSGTXT001" parent="1" style="whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#16191F;fontFamily=Helvetica;fontStyle=0;" value="Inbound: TCP 6379 (Redis) from App-SG only&amp;nbsp;" vertex="1">
          <mxGeometry height="40" width="345" x="445" y="767" as="geometry" />
        </mxCell>
        <mxCell id="P3REDISEDGE001" edge="1" parent="1" source="140149601891776" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Helvetica;fontSize=11.5;fontColor=#16191F;" target="P3REDIS001" value="Redis : 6379">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="140149601893312" parent="1" style="whiteSpace=wrap;rounded=1;fillColor=#FFF9E6;strokeColor=#D9A400;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#16191F;fontFamily=Helvetica;arcSize=4;spacing=8;" value="Security Groups are stateful and enforce resource-level control; Network ACLs (stateless, subnet-level) can add a further layer where required. Database subnets have no route to the Internet Gateway, so RDS/Redis are unreachable from the internet regardless of Security Group rules. Interface VPC Endpoints (ECR, Secrets Manager, SSM) share a dedicated Endpoint-SG allowing TCP 443 from App-SG only — no NAT Gateway is used. GitHub Actions authenticates to AWS via OIDC (no static AWS keys) — see page 6." vertex="1">
          <mxGeometry height="90" width="1370" x="-10" y="870" as="geometry" />
        </mxCell>
        <mxCell id="140149601893504" parent="1" style="whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;dashed=0;html=1;align=left;verticalAlign=middle;fontSize=25;fontColor=#16191F;fontFamily=Helvetica;fontStyle=1;" value="Security Group Reference" vertex="1">
